<Project Sdk="Microsoft.NET.Sdk">

  <!-- net8.0 alone, and deliberately: this is the one project in the repository
       that is a process rather than a library. Nothing loads it into a net48
       add-in host, so the multi-target that decision 5 argues for on reach grounds
       would buy nothing and cost a second set of binaries. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>griffel_femex.Cli</RootNamespace>

    <!-- The binary is `femex`, which is how every verb in C5 is spelled. -->
    <AssemblyName>femex</AssemblyName>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>

    <!-- The batch driver of C4 is what a migration engagement runs, and it is run
         from a shell. Invariant globalization keeps `femex check` over forty models
         producing the same document on a German machine as on an English one. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- The report, and the one adapter there is. C5: `femex convert` wraps the SAF
       adapter so the same binary is how a conversion is done at all — which is also
       what puts the LGPL EPPlus question of B1 in a distributed artefact rather than
       in a hypothetical one. The answer is confirmed in the adapter's own csproj. -->
  <ItemGroup>
    <ProjectReference Include="..\griffel-femex.Reporting\griffel-femex.Reporting.csproj" />
    <ProjectReference Include="..\griffel-femex.Adapters.Saf\griffel-femex.Adapters.Saf.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <Authors>Aliaksandr Valodzin</Authors>
    <Copyright>Copyright 2026 Aliaksandr Valodzin</Copyright>
    <Description>femex — model assurance for FEMEX and SAF.</Description>
    <RepositoryUrl>https://github.com/AliaksandrValodzin/griffel-femex</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>

    <!-- Nothing here is published as a package; this is a process, and the metadata
         above exists so the assembly identifies itself. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- This is the artefact that is actually handed to someone, so this is where the
       licence obligations have to land. NOTICE names EPPlus 4.5.3.3 and states the
       relinking freedom; licenses\LGPL-3.0.txt is the text that freedom is granted
       by. Both sit beside femex.exe and EPPlus.dll in the output and in a publish.

       Stated explicitly rather than left to transitive content flow from the
       adapter project: whether a referenced project's content reaches a publish
       directory is an MSBuild detail, and a licence obligation that depends on one
       is an obligation that can be lost by a build change nobody connects to it. -->
  <ItemGroup>
    <None Include="..\NOTICE" Link="NOTICE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\griffel-femex.Adapters.Saf\licenses\LGPL-3.0.txt"
          Link="licenses\LGPL-3.0.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
