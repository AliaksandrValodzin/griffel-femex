<Project Sdk="Microsoft.NET.Sdk">

  <!-- Multi-targeted per FEMEX_Adapters.md §3.7. netstandard2.0 is the only target
       both net48 add-in hosts and modern .NET can consume; net8.0 gives current
       hosts a first-class one. The reason is reach: a library given away under
       Apache-2.0 to buy distribution must not exclude every .NET Framework
       consumer in the market it is aimed at. -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <RootNamespace>griffel_femex</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- The SDK defaults netstandard2.0 to C# 7.3, which has neither nullable
         reference types nor record structs. Both legs compile the same sources,
         so both get the same language version. -->
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Packaging metadata. Nothing is published by this: it makes publishing
       possible, not done. The reason it is here at all is that the whole case for
       adapting SAF first was distribution reach, and reach a library cannot be
       fetched over is notional. `dotnet pack` resolving is what makes it real.

       PackageLicenseExpression rather than PackageLicenseFile: the expression is
       what NuGet indexes and what a consumer's licence-scanning tool reads, and
       LICENSE is in the repository beside this file either way. -->
  <PropertyGroup>
    <PackageId>Griffel.Femex</PackageId>
    <Authors>Aliaksandr Valodzin</Authors>
    <Copyright>Copyright 2026 Aliaksandr Valodzin</Copyright>
    <Description>The FEMEX structural analysis model format: the schema, the model, and the validator that says what is wrong with a model. Every transfer declares what it cost in a fixed loss taxonomy. No third-party dependency on net8.0.</Description>
    <PackageTags>structural;fem;analysis;interoperability;femex;saf</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/AliaksandrValodzin/griffel-femex</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/AliaksandrValodzin/griffel-femex</PackageProjectUrl>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- Packed, not merely present: a NOTICE that stays in the repository does not
       travel with the artefact, which is the whole failure this pass exists to fix. -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="NOTICE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- netstandard2.0 does not carry System.Text.Json, and the library needs a
       modern one: [JsonPolymorphic]/[JsonDerivedType] (Geometry/Sections/Section.cs)
       and IJsonOnDeserialized (FemexModel.SelfWeight.cs) are STJ 7+. This ends the
       project's zero-package record deliberately rather than by accident, and it is
       an assembly-binding hazard inside a net48 AppDomain — see FEMEX_Adapters.md
       §3.7. The net8.0 leg has it in the shared framework and takes no reference. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <!-- The test project lives in a subfolder; keep its sources out of the library.
       So do the SAF adapter and its tests, which reference this project and would
       otherwise be compiled into it — taking the SAF SDK, EPPlus and SimpleInjector
       with them and ending the library's independence from any vendor.

       The same applies to Phase C's reporting layer and CLI: every project in this
       repository sits under the library's own source glob, so each one needs a line
       here or it is compiled twice and every type it declares collides with itself
       (CS0436). One line per project, no glob, matching the copy rules in the test
       projects: a new project that gains no line here fails loudly rather than
       silently doubling the library. -->
  <ItemGroup>
    <Compile Remove="griffel-femex.Tests\**\*.cs" />
    <None Remove="griffel-femex.Tests\**\*" />
    <Compile Remove="griffel-femex.Adapters.Saf\**\*.cs" />
    <None Remove="griffel-femex.Adapters.Saf\**\*" />
    <Compile Remove="griffel-femex.Adapters.Saf.Tests\**\*.cs" />
    <None Remove="griffel-femex.Adapters.Saf.Tests\**\*" />
    <Compile Remove="griffel-femex.Reporting\**\*.cs" />
    <None Remove="griffel-femex.Reporting\**\*" />
    <Compile Remove="griffel-femex.Reporting.Tests\**\*.cs" />
    <None Remove="griffel-femex.Reporting.Tests\**\*" />
    <Compile Remove="griffel-femex.Cli\**\*.cs" />
    <None Remove="griffel-femex.Cli\**\*" />
    <Compile Remove="griffel-femex.Cli.Tests\**\*.cs" />
    <None Remove="griffel-femex.Cli.Tests\**\*" />
  </ItemGroup>

</Project>
