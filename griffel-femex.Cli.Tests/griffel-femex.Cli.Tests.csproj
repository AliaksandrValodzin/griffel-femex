<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>griffel_femex.Cli.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.5.0" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="3.2.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The exe itself, referenced as a library. Cli.Run takes its writers as
       arguments precisely so the end-to-end verification is a method call rather
       than a process launch whose console has to be parsed. -->
  <ItemGroup>
    <ProjectReference Include="..\griffel-femex.Cli\griffel-femex.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Examples\Example1.femex" Link="Examples\Example1.femex"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Examples\Example2.femex" Link="Examples\Example2.femex"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Examples\Example3.femex" Link="Examples\Example3.femex"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Examples\Conformance1.femex" Link="Examples\Conformance1.femex"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Examples\Parity1.femex" Link="Examples\Parity1.femex"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The published SAF corpus, borrowed from the adapter's suite: C's verification
       says batch mode is proven on it, and a batch driver proven on one folder of
       four hand-written examples would not be proven on anything a client sends.

       One line per file, no glob, matching every other copy rule in this
       repository. -->
  <ItemGroup>
    <None Include="..\griffel-femex.Adapters.Saf.Tests\Corpus\SAF_example_HOUSE_metric_ZYX_200.xlsx" Link="Corpus\SAF_example_HOUSE_metric_ZYX_200.xlsx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\griffel-femex.Adapters.Saf.Tests\Corpus\SAF_example_HOUSE_metric_ZYX_210.xlsx" Link="Corpus\SAF_example_HOUSE_metric_ZYX_210.xlsx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\griffel-femex.Adapters.Saf.Tests\Corpus\SAF_example_HOUSE_metric_ZYX_220.xlsx" Link="Corpus\SAF_example_HOUSE_metric_ZYX_220.xlsx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\griffel-femex.Adapters.Saf.Tests\Corpus\SAF_example_STEEL_HALL_metrix_ZYX_105.xlsx" Link="Corpus\SAF_example_STEEL_HALL_metrix_ZYX_105.xlsx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\griffel-femex.Adapters.Saf.Tests\Corpus\SAF_example_STEEL_HALL_metrix_ZYX_106.xlsx" Link="Corpus\SAF_example_STEEL_HALL_metrix_ZYX_106.xlsx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\griffel-femex.Adapters.Saf.Tests\Corpus\SAF_example_STEEL_HALL_metrix_ZYX_107.xlsx" Link="Corpus\SAF_example_STEEL_HALL_metrix_ZYX_107.xlsx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\griffel-femex.Adapters.Saf.Tests\Corpus\SAF_example_STEEL_HALL_metrix_ZYX_108.xlsx" Link="Corpus\SAF_example_STEEL_HALL_metrix_ZYX_108.xlsx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\griffel-femex.Adapters.Saf.Tests\Corpus\SAF_example_STEEL_HALL_metrix_ZYX_109.xlsx" Link="Corpus\SAF_example_STEEL_HALL_metrix_ZYX_109.xlsx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\griffel-femex.Adapters.Saf.Tests\Corpus\SAF_example_STEEL_HALL_metrix_ZYX_110.xlsx" Link="Corpus\SAF_example_STEEL_HALL_metrix_ZYX_110.xlsx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\griffel-femex.Adapters.Saf.Tests\Corpus\SAF_example_STEEL_HALL_metrix_ZYX_200.xlsx" Link="Corpus\SAF_example_STEEL_HALL_metrix_ZYX_200.xlsx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\griffel-femex.Adapters.Saf.Tests\Corpus\SAF_example_STEEL_HALL_metrix_ZYX_210.xlsx" Link="Corpus\SAF_example_STEEL_HALL_metrix_ZYX_210.xlsx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
